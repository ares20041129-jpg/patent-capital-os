{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.patent-capital-os/schemas/submission-authorization.schema.json",
  "title": "Patent Capital OS Submission Authorization Packet",
  "type": "object",
  "required": [
    "case_id",
    "filing_type",
    "jurisdiction",
    "final_documents",
    "hashes",
    "counsel_review",
    "applicant_authorization",
    "inventor_confirmation",
    "ownership",
    "secrecy_review",
    "agency",
    "filing_channel",
    "fees"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "filing_type": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "business_goal": { "type": "string" },
    "final_documents": {
      "type": "object",
      "required": ["claims", "specification", "abstract", "drawings", "request_metadata"],
      "properties": {
        "claims": { "type": "string", "minLength": 1 },
        "specification": { "type": "string", "minLength": 1 },
        "abstract": { "type": "string", "minLength": 1 },
        "drawings": { "type": "string", "minLength": 1 },
        "request_metadata": { "type": "string", "minLength": 1 }
      }
    },
    "hashes": {
      "type": "object",
      "required": ["source_package", "final_claims", "final_specification", "final_xml"],
      "properties": {
        "source_package": { "type": "string", "minLength": 1 },
        "final_claims": { "type": "string", "minLength": 1 },
        "final_specification": { "type": "string", "minLength": 1 },
        "final_xml": { "type": "string", "minLength": 1 }
      }
    },
    "counsel_review": {
      "type": "object",
      "required": ["reviewer_name", "reviewer_role", "organization", "approval_statement", "reviewed_hash", "timestamp"],
      "properties": {
        "reviewer_name": { "type": "string", "minLength": 1 },
        "reviewer_role": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "license_or_agent_identifier": { "type": "string" },
        "approval_statement": { "type": "string", "minLength": 1 },
        "reviewed_hash": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 }
      }
    },
    "applicant_authorization": {
      "type": "object",
      "required": ["applicant_name", "authorized_person", "authority_basis", "allowed_actions", "timestamp"],
      "properties": {
        "applicant_name": { "type": "string", "minLength": 1 },
        "authorized_person": { "type": "string", "minLength": 1 },
        "authority_basis": { "type": "string", "minLength": 1 },
        "allowed_actions": {
          "oneOf": [
            { "type": "array", "minItems": 1, "items": { "type": "string" } },
            { "type": "string", "minLength": 1 }
          ]
        },
        "timestamp": { "type": "string", "minLength": 1 }
      }
    },
    "inventor_confirmation": {
      "type": "object",
      "required": ["inventors", "contribution_confirmed"],
      "properties": {
        "inventors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contribution_confirmed": { "const": true }
      }
    },
    "ownership": {
      "type": "object",
      "required": ["basis", "evidence"],
      "properties": {
        "basis": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "agency": {
      "type": "object",
      "required": ["agent_or_firm", "appointment_evidence"],
      "properties": {
        "agent_or_firm": { "type": "string", "minLength": 1 },
        "appointment_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "filing_channel": {
      "type": "object",
      "required": ["official_system", "account_owner", "signature_authority"],
      "properties": {
        "official_system": { "type": "string", "minLength": 1 },
        "account_owner": { "type": "string", "minLength": 1 },
        "signature_authority": { "type": "string", "minLength": 1 },
        "automation_allowed": { "type": "boolean" }
      }
    },
    "fees": {
      "type": "object",
      "required": ["payer", "fee_reduction", "auto_pay_authorized"],
      "properties": {
        "payer": { "type": "string", "minLength": 1 },
        "fee_reduction": { "type": "boolean" },
        "auto_pay_authorized": { "const": true }
      }
    }
  }
}
